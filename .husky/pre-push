#!/bin/sh
. "$(dirname "$0")/ensure-runtime.sh"

echo "🔍 运行推送前检查..."
echo ""

# Medium-load pre-push validation
echo "🚦 运行中负载推送门禁..."
if resolve_bun_bin; then
  run_bun run validate:release --mode prepush --quiet
else
  run_node_tool scripts/validate-release.mjs --mode prepush --quiet
fi
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ 中负载推送门禁失败，请根据 validate:release 输出修复后再推送"
  exit 1
fi

echo ""
echo "ℹ️  pre-push 不运行 Docker/browser full release gate。发布前请显式执行：bun run validate:release --mode local"

echo ""
echo "✅ 所有检查通过，准备推送..."
