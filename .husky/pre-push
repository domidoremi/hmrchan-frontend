#!/bin/sh
. "$(dirname "$0")/ensure-runtime.sh"

echo "🔍 运行推送前检查..."
echo ""

# Medium-load pre-push validation. This intentionally excludes build, full unit,
# Docker, browser, and local audit gates.
echo "🚦 运行中负载 Hook 门禁..."
if resolve_bun_bin; then
  run_bun run validate:release --mode hook --quiet
else
  run_node_tool scripts/validate-release.mjs --mode hook --quiet
fi
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ 中负载推送门禁失败，请根据 validate:release 输出修复后再推送"
  exit 1
fi

echo ""
echo "ℹ️  pre-push 不运行 build/full unit/Docker/browser gate。发布前请显式执行：bun run validate:release --mode local"

echo ""
echo "✅ 所有检查通过，准备推送..."
