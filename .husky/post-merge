#!/bin/sh
# Post-merge hook
echo "🔄 检查合并后的变更..."

# Check if package.json or bun.lock changed
changed_files="$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD)"

check_dependency_change() {
  if echo "$changed_files" | grep -q "$1"; then
    echo ""
    echo "📦 检测到 $1 变更"
    echo "💡 建议运行: bun install"
    echo ""
    return 0
  fi
  return 1
}

check_dependency_change "package.json" || check_dependency_change "bun.lock"

# Check if .env.example changed
if echo "$changed_files" | grep -q ".env.example"; then
  echo ""
  echo "⚙️  检测到 .env.example 变更"
  echo "💡 请检查并更新你的 .env 文件"
  echo ""
fi
