          "{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Organization\",\n  \"name\": \"Brand Appart\",\n  \"url\": \"https://brandappart.com/\",\n  \"logo\": \"/brand-appart/assets/images/bbbf5bcecb86-68b700baf612d68094807ab7_in.png\",\n  \"description\": \"We help startups and scale-ups stand out with sharp branding, smart UX/UI, and high-impact digital products. Build boldly with Brand Appart.\",\n  \"foundingLocation\": {\n    \"@type\": \"Place\",\n    \"address\": {\n      \"@type\": \"PostalAddress\",\n      \"addressLocality\": \"Paris\",\n      \"addressCountry\": \"France\"\n    }\n  },\n  \"sameAs\": [\n    \"https://www.instagram.com/brandappart/\",\n    \"https://x.com/brandappart_\",\n    \"https://www.linkedin.com/company/brandappart/\",\n    \"https://www.behance.net/brandappart-\"\n  ],\n  \"contactPoint\": {\n    \"@type\": \"ContactPoint\",\n    \"contactType\": \"sales\",\n    \"url\": \"https://brandappart.com/start-a-project\"\n  },\n  \"hasOfferCatalog\": {\n    \"@type\": \"OfferCatalog\",\n    \"name\": \"Services\",\n    \"itemListElement\": [\n      {\n        \"@type\": \"Offer\",\n        \"itemOffered\": {\n          \"@type\": \"Service\",\n          \"name\": \"Branding that drives conversion & funding\",\n          \"description\": \"Clarify positioning, define tone of voice, build visual system including logo, brand guidelines, and social kit.\"\n        }\n      },\n      {\n        \"@type\": \"Offer\",\n        \"itemOffered\": {\n          \"@type\": \"Service\",\n          \"name\": \"Product experiences users adopt & keep using\",\n          \"description\": \"Business goal alignment, journey mapping, prototyping, UI library, and dev-ready deliverables to improve retention and NPS.\"\n        }\n      },\n      {\n        \"@type\": \"Offer\",\n        \"itemOffered\": {\n          \"@type\": \"Service\",\n          \"name\": \"Web Design for growing teams & business\",\n          \"description\": \"Messaging alignment, page architecture, scalable UI, fast loading sites that tell the right story and push to action.\"\n        }\n      },\n      {\n        \"@type\": \"Offer\",\n        \"itemOffered\": {\n          \"@type\": \"Service\",\n          \"name\": \"Investor-proof decks that raise faster\",\n          \"description\": \"Narrative crafting, readable numbers, slide rhythm, teaser and one-pager versions for faster responses.\"\n        }\n      }\n    ]\n  },\n  \"employee\": [\n    {\n      \"@type\": \"Person\",\n      \"name\": \"Arthur Humeau\",\n      \"image\": \"/brand-appart/assets/images/aeec5ef9dac7-6804deace08d0d6757751ecb_arthur.jpg\"\n    },\n    {\n      \"@type\": \"Person\",\n      \"name\": \"Victor Lignel\",\n      \"image\": \"/brand-appart/assets/images/9b9b1294a9f1-685849b4cabd263c42c148fa_Photo_Victor.avif\"\n    },\n    {\n      \"@type\": \"Person\",\n      \"name\": \"Théodore Jean\",\n      \"image\": \"/brand-appart/assets/images/fa8c722806a2-6804ded0b12ac6c26c3c0433_theodore.avif\"\n    }\n  ],\n  \"workExample\": [\n    {\n      \"@type\": \"CreativeWork\",\n      \"name\": \"Incard\",\n      \"url\": \"https://brandappart.com/work/incard\",\n      \"genre\": \"Fintech\",\n      \"datePublished\": \"2024\"\n    },\n    {\n      \"@type\": \"CreativeWork\",\n      \"name\": \"Sowbeez\",\n      \"url\": \"https://brandappart.com/work/sowbeez\",\n      \"genre\": \"B2C App\",\n      \"datePublished\": \"2023\"\n    },\n    {\n      \"@type\": \"CreativeWork\",\n      \"name\": \"Forbes\",\n      \"url\": \"https://brandappart.com/work/forbes\",\n      \"genre\": \"Web 3.0\",\n      \"datePublished\": \"2023\"\n    },\n    {\n      \"@type\": \"CreativeWork\",\n      \"name\": \"Gostan\",\n      \"url\": \"https://brandappart.com/work/gostan\",\n      \"genre\": \"B2B SaaS\",\n      \"datePublished\": \"2024\"\n    },\n    {\n      \"@type\": \"CreativeWork\",\n      \"name\": \"We are\",\n      \"url\": \"https://brandappart.com/work/we-are\",\n      \"genre\": \"B2B SaaS\",\n      \"datePublished\": \"2024\"\n    },\n    {\n      \"@type\": \"CreativeWork\",\n      \"name\": \"Stables\",\n      \"url\": \"https://brandappart.com/work/stables\",\n      \"genre\": \"Web 3.0\",\n      \"datePublished\": \"2022\"\n    },\n    {\n      \"@type\": \"CreativeWork\",\n      \"name\": \"Varzii\",\n      \"url\": \"https://brandappart.com/work/varzii\",\n      \"genre\": \"Web 3.0\",\n      \"datePublished\": \"2022\"\n    }\n  ],\n  \"review\": [\n    {\n      \"@type\": \"Review\",\n      \"author\": {\n        \"@type\": \"Person\",\n        \"name\": \"Alexis Gendreau\",\n        \"jobTitle\": \"Founder\",\n        \"affiliation\": \"GoStan\"\n      },\n      \"reviewBody\": \"Brand Appart quickly identified our needs and proposed highly relevant creative directions. We’re thrilled with the branding they created for GoStan.\"\n    },\n    {\n      \"@type\": \"Review\",\n      \"author\": {\n        \"@type\": \"Person\",\n        \"name\": \"Jérémy Bendayan\",\n        \"jobTitle\": \"Co-founder & COO\",\n        \"affiliation\": \"Jaws Group\"\n      },\n      \"reviewBody\": \"Working with Brand Appart has been an absolute pleasure. Beyond their creativity and professionalism, there’s a real sense of kindness and care in everything they do.\"\n    },\n    {\n      \"@type\": \"Review\",\n      \"author\": {\n        \"@type\": \"Person\",\n        \"name\": \"Théo Cesarini\",\n        \"jobTitle\": \"CEO & Co-Founder\",\n        \"affiliation\": \"Incard & Fundree\"\n      },\n      \"reviewBody\": \"A huge thank you to the entire Brand Appart team for your outstanding work on our rebranding! We’re thrilled to have you as an integral part of the Incard team.\"\n    },\n    {\n      \"@type\": \"Review\",\n      \"author\": {\n        \"@type\": \"Person\",\n        \"name\": \"Alexis Botaya\",\n        \"jobTitle\": \"Managing director\",\n        \"affiliation\": \"Sound Experience\"\n      },\n      \"reviewBody\": \"I’ve worked with Brand Appart on multiple projects website development, landing pages for branding, and PowerPoint presentations. I love how flexible, fast, and professional the team is.\"\n    },\n    {\n      \"@type\": \"Review\",\n      \"author\": {\n        \"@type\": \"Person\",\n        \"name\": \"Maxime Leclercq\",\n        \"jobTitle\": \"Head of Sales\",\n        \"affiliation\": \"Scalability\"\n      },\n      \"reviewBody\": \"Working with Brand Appart was a great experience. They brought real creative firepower to the table — smart ideas, fast execution, and high-quality deliverables.\"\n    },\n    {\n      \"@type\": \"Review\",\n      \"author\": {\n        \"@type\": \"Person\",\n        \"name\": \"Roy Masliah\",\n        \"jobTitle\": \"Founder\",\n        \"affiliation\": \"Decla.fr, Honoré Patrimoine\"\n      },\n      \"reviewBody\": \"I had the chance to work with BrandAppart on the redesign of Decla.fr’s UX and UI, and I highly recommend them. They create experiences that convert, reassure, and simplify.\"\n    },\n    {\n      \"@type\": \"Review\",\n      \"author\": {\n        \"@type\": \"Person\",\n        \"name\": \"David Haiun\",\n        \"jobTitle\": \"Founder\",\n        \"affiliation\": \"Olea & Thermobat\"\n      },\n      \"reviewBody\": \"Working with Brand Appart means having a true partner, attentive, responsive, and creative. They propose meaningful solutions without losing sight of efficiency.\"\n    },\n    {\n      \"@type\": \"Review\",\n      \"author\": {\n        \"@type\": \"Person\",\n        \"name\": \"Thomas Lemaitre\",\n        \"jobTitle\": \"Head of Marketing\",\n        \"affiliation\": \"Jalao\"\n      },\n      \"reviewBody\": \"We worked to revamp our brand identity and web experience and the result was beyond expectations. They combine bold creative direction with deep understanding of business goals.\"\n    },\n    {\n      \"@type\": \"Review\",\n      \"author\": {\n        \"@type\": \"Person\",\n        \"name\": \"Elliot Collignon\",\n        \"jobTitle\": \"CMO\",\n        \"affiliation\": \"PlayStable & Ledger\"\n      },\n      \"reviewBody\": \"We worked together on branding and all the visuals we shared on social media. I only have good things to say about our collab with them, it’s been a great experience!\"\n    }\n  ],\n  \"mainEntityOfPage\": {\n    \"@type\": \"WebPage\",\n    \"@id\": \"https://brandappart.com/\"\n  }\n}"
        ]
