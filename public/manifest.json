    },
    {
      "src": "/screenshots/home-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "首页 - 桌面端"
    }
  ],
  "shortcuts": [
    {
      "name": "首页",
      "short_name": "首页",
      "description": "返回首页浏览最新内容",
      "url": "/?source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-home.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "探索",
      "short_name": "探索",
      "description": "发现更多精彩内容",
      "url": "/explore?source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-explore.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "收藏",
      "short_name": "收藏",
      "description": "查看我的收藏内容",
      "url": "/favorites?source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-favorites.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "设置",
      "short_name": "设置",
      "description": "个性化设置和偏好",
      "url": "/settings?source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-settings.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "scope": "/",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "video/*"]
        }
      ]
    }
  },
  "edge_side_panel": {
    "preferred_width": 400
  }
}
