# Cloudflare Pages HTTP headers

# 通用安全头
/*
  # HSTS - 强制 HTTPS
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # 防止点击劫持
  X-Frame-Options: SAMEORIGIN
  
  # 防止 MIME 类型嗅探
  X-Content-Type-Options: nosniff
  
  # Referrer 策略
  Referrer-Policy: strict-origin-when-cross-origin
  
  # 跨域策略
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: cross-origin
  
  # 权限策略
  Permissions-Policy: camera=(), microphone=(), geolocation=(), fullscreen=(self), payment=()
  
  # 内容安全策略（安全优化版）
  # 注意：Cloudflare Pages 的 _headers 文件有时会被忽略
  # 如果此配置未生效，需要在 Cloudflare Dashboard 中手动配置 Transform Rules
  #
  # script-src: 用 hash 替代 'unsafe-inline'，仅允许 frame-guard 内联脚本
  #   hash: 'sha256-gQxtaB/fHoD0PKLcLhsW2rm03+//Pw/+Zq8q5+UQIFg='
  #   若修改 index.html 中 frame-guard <script> 内容，需重新计算：
  #   node scripts/compute-csp-hash.mjs
  # style-src: 保留 'unsafe-inline'（critical CSS 每次构建内容不同 + Vue 运行时样式注入）
  # 'unsafe-eval': 部分第三方库可能需要，后续可尝试移除并测试
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-gQxtaB/fHoD0PKLcLhsW2rm03+//Pw/+Zq8q5+UQIFg=' 'unsafe-eval' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://api.momichan.xyz https://api.dicebear.com https://challenges.cloudflare.com https://static.cloudflareinsights.com https://cloudflareinsights.com https://pbs.twimg.com https://i.ytimg.com; media-src 'self' https: blob:; object-src 'none'; worker-src 'self' blob:; frame-src 'self' https://challenges.cloudflare.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# HTML 页面 - 短缓存，便于快速更新
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# 主入口（index.html）
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# JavaScript 与 CSS 打包产物 - 长缓存（带哈希）
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# 图片资源
/assets/*.(png|jpg|jpeg|gif|svg|webp|avif)
  Cache-Control: public, max-age=31536000, immutable

# 字体文件
/assets/*.(woff|woff2|ttf|otf)
  Cache-Control: public, max-age=31536000, immutable

# Service Worker - 禁止缓存
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

# Favicon
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
