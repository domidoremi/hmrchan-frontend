# Cloudflare Pages HTTP headers

# 通用安全头
/*
  # HSTS - 强制 HTTPS（2 年有效期 + preload 列表）
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  
  # 防止点击劫持
  X-Frame-Options: SAMEORIGIN
  
  # 防止 MIME 类型嗅探
  X-Content-Type-Options: nosniff
  
  # Referrer 策略
  Referrer-Policy: strict-origin-when-cross-origin
  
  # 跨域策略
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: cross-origin
  Cross-Origin-Embedder-Policy: credentialless
  
  # 阻止 Flash/PDF 跨域策略文件
  X-Permitted-Cross-Domain-Policies: none
  
  # 权限策略（最小权限原则）
  # clipboard-write=(self): 分享链接复制功能
  # picture-in-picture=(self): 视频画中画
  # autoplay=(self): 帖子图片自动轮播
  Permissions-Policy: camera=(), microphone=(), geolocation=(), fullscreen=(self), payment=(), accelerometer=(), gyroscope=(), magnetometer=(), midi=(), usb=(), display-capture=(), screen-wake-lock=(), xr-spatial-tracking=(), clipboard-read=(), clipboard-write=(self), picture-in-picture=(self), autoplay=(self)
  
  # 内容安全策略
  # script-src: hash 替代 unsafe-inline，无 unsafe-eval（Vue 3 SFC 预编译无需 eval）
  #   hash1: frame-guard 内联脚本（修改后需重算: node scripts/compute-csp-hash.mjs）
  #   Cloudflare beacon: 通过 index.html 手动引入外部脚本，由域名白名单覆盖
  #     如仍有 Cloudflare 注入的内联脚本被阻止，在 Dashboard 关闭:
  #     Speed > Optimization > Auto Minify (JS) / Rocket Loader
  # style-src: 保留 unsafe-inline（critical CSS 每次构建变化 + Vue 运行时样式）
  # media-src: 所有媒体通过 /api 代理，无需 https: 通配
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-gQxtaB/fHoD0PKLcLhsW2rm03+//Pw/+Zq8q5+UQIFg=' 'sha256-3k1Ko7n0RlNGvG5xV9GnGB+MAQOob7mOU6V1w5s86Lw=' 'sha256-ph3AkIn7ozIhXCPVYLJG0nnQQlsL8NUjOzn7gFpSrGU=' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://api.momichan.xyz https://api.dicebear.com https://challenges.cloudflare.com https://static.cloudflareinsights.com https://cloudflareinsights.com https://pbs.twimg.com https://i.ytimg.com; media-src 'self' blob:; object-src 'none'; worker-src 'self' blob:; frame-src 'self' https://challenges.cloudflare.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# HTML 页面 - 短缓存，便于快速更新
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# 主入口（index.html）
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# JavaScript 与 CSS 打包产物 - 长缓存（带哈希）
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# 图片资源
/assets/*.(png|jpg|jpeg|gif|svg|webp|avif)
  Cache-Control: public, max-age=31536000, immutable

# 字体文件
/assets/*.(woff|woff2|ttf|otf)
  Cache-Control: public, max-age=31536000, immutable

# Service Worker - 禁止缓存
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

# Favicon
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
