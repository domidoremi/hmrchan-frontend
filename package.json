{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ],
  "scripts": {
    "dev": "node scripts/patch-lucide-vue-next.mjs && vite",
    "build": "node scripts/patch-lucide-vue-next.mjs && vue-tsc --noEmit --pretty && node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "postinstall": "node scripts/patch-lucide-vue-next.mjs",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run scripts/test-e2e.ts",
    "test:perf": "bun run scripts/test-performance.ts",
    "test:a11y": "bun run scripts/test-accessibility.ts",
    "check:frontend": "bun run scripts/frontend-health-check.ts",
    "type-check": "vue-tsc --noEmit --pretty",
    "type-check:watch": "vue-tsc --noEmit --watch --pretty",
    "prepare": "husky",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "perf:lighthouse": "node scripts/lighthouse-audit.mjs",
    "perf:lighthouse:prod": "node scripts/lighthouse-prod-audit.mjs",
    "perf:lighthouse:prod:all": "node scripts/lighthouse-prod-audit.mjs --orchestrate",
    "perf:lighthouse:prod:full": "node scripts/lighthouse-prod-full-audit.mjs",
    "lint:strict": "eslint . --ext .vue,.ts,.tsx --max-warnings=0",
    "format:check": "prettier --check src/",
    "lint-staged": "lint-staged",
    "serve:dist": "bunx serve dist -l 3000",
    "clean": "rm -rf dist node_modules/.vite .tsbuildinfo",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "sitemap:preview": "node scripts/generate-sitemap.js --dry-run",
    "icons:generate": "node scripts/generate-icons.js",
    "screenshots:generate": "bun run scripts/generate-screenshots.ts",
    "audit": "bun run audit:repo && bun run audit:deps",
    "audit:repo": "bun run scripts/audit/index.ts",
    "audit:deps": "bun audit",
    "audit:fix": "bun run scripts/audit/index.ts --fix",
    "commit:cn": "node scripts/git-commit.mjs"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.1.0",
    "dompurify": "^3.3.3",
    "gsap": "^3.14.2",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "3.6.0-beta.8",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/eslint-plugin": "^1.6.12",
    "@vue/compiler-sfc": "3.6.0-beta.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "estree-walker": "3.0.3",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.1",
    "knip": "^5.86.0",
    "lighthouse": "^13.0.3",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "puppeteer": "^24.40.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vite-imagetools": "^10.0.0",
    "vite-plugin-vue-devtools": "^8.1.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.6"
  },
  "overrides": {
    "basic-ftp": "^5.2.0",
    "flatted": "^3.4.2",
    "lodash-es": "^4.17.23",
    "minimatch": "^10.2.4",
    "rollup": "^4.59.1"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.0.0-rc.10"
  }
}
