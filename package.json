{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ],
  "overrides": {
    "vite-plugin-vue-devtools": {
      "vite": "8.0.0-beta.10"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/update-sw-version.js && bun run type-check && vite build",
    "build:analyze": "node scripts/update-sw-version.js && vite build && node scripts/analyze-bundle.js",
    "build:measure": "node scripts/measure-build-time.js",
    "preview": "vite preview",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:watch": "vitest",
    "test:perf": "bun run scripts/test-performance.ts",
    "type-check": "vue-tsc --noEmit --pretty",
    "type-check:watch": "vue-tsc --noEmit --watch --pretty",
    "prepare": "husky",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "perf:dev": "node scripts/measure-dev-startup.js",
    "perf:hmr": "node scripts/analyze-hmr-performance.js",
    "perf:lighthouse": "node scripts/lighthouse-audit.mjs",
    "perf:build": "node scripts/measure-build-time.js",
    "perf:compare": "node scripts/compare-build-configs.js",
    "lint:strict": "eslint . --ext .vue,.ts,.tsx --max-warnings=0",
    "format:check": "prettier --check src/",
    "lint-staged": "lint-staged",
    "serve:dist": "bunx serve dist -l 3000",
    "clean": "rm -rf dist node_modules/.vite .tsbuildinfo",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "sitemap:preview": "node scripts/generate-sitemap.js --dry-run",
    "icons:generate": "node scripts/generate-icons.js",
    "screenshots:generate": "node scripts/generate-screenshots.js"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.0.1",
    "@rive-app/canvas": "^2.34.1",
    "gsap": "^3.14.2",
    "lottie-web": "^5.13.0",
    "lucide-vue-next": "^0.563.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.27",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260124.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.0.10",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vitest/eslint-plugin": "^1.6.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "chrome-launcher": "^1.2.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "knip": "^5.82.1",
    "lighthouse": "^13.0.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vite": "8.0.0-beta.10",
    "vite-imagetools": "^9.0.2",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.0-rc.1"
  }
}
