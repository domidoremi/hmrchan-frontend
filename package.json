{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "engines": {
    "node": ">=26.13.1 <27",
    "bun": ">=1.4.4"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:security-check": "node scripts/check-build-security.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "postinstall": "node scripts/patch-lucide.mjs",
    "test:unit": "node scripts/patch-lucide.mjs && node scripts/run-vitest.mjs run --maxWorkers=1",
    "test:unit:watch": "node scripts/patch-lucide.mjs && node scripts/run-vitest.mjs",
    "test:coverage": "node scripts/patch-lucide.mjs && node scripts/run-vitest.mjs run --coverage --maxWorkers=1",
    "test:e2e": "bun run scripts/test-e2e.ts",
    "test:functional-chain:local": "bun run scripts/test-functional-chain-local.ts",
    "validate:release": "node scripts/validate-release.mjs",
    "validate:release:hook": "node scripts/validate-release.mjs --mode hook --quiet",
    "validate:release:prepush": "node scripts/validate-release.mjs --mode prepush --quiet",
    "validate:release:prepush:full": "node scripts/validate-release.mjs --mode prepush-full --quiet",
    "validate:release:local": "node scripts/validate-release.mjs --mode local",
    "validate:release:local:quiet": "node scripts/validate-release.mjs --mode local --quiet",
    "validate:release:candidate": "node scripts/validate-release.mjs --mode candidate",
    "validate:release:production": "node scripts/validate-release.mjs --mode production",
    "check:release-evidence": "node scripts/release-evidence.mjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "check:complexity-budget": "node scripts/check-complexity-budget.mjs",
    "test:perf": "bun run scripts/test-performance.ts",
    "test:a11y": "bun run scripts/test-accessibility.ts",
    "check:frontend": "bun run scripts/frontend-health-check.ts",
    "type-check": "bun run type-check:app && bun run type-check:functions && bun run type-check:worker",
    "type-check:app": "node scripts/check-app-type-budget.mjs",
    "type-check:app:strict": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit --pretty --project tsconfig.app.json",
    "type-check:functions": "node node_modules/@typescript/native/bin/tsc --noEmit --pretty --project functions/tsconfig.json",
    "type-check:worker": "node node_modules/@typescript/native/bin/tsc --noEmit --pretty --project workers/internal-api/tsconfig.json",
    "type-check:watch": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit --watch --pretty",
    "prepare": "node node_modules/husky/bin.js",
    "lint": "node node_modules/eslint/bin/eslint.js . --fix --cache",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src/",
    "perf:lighthouse": "node scripts/lighthouse-audit.mjs",
    "perf:lighthouse:prod": "node scripts/lighthouse-prod-audit.mjs",
    "perf:lighthouse:prod:all": "node scripts/lighthouse-prod-audit.mjs --orchestrate",
    "perf:lighthouse:prod:full": "node scripts/lighthouse-prod-full-audit.mjs",
    "test:prod:regression": "node scripts/prod-regression-runner.mjs",
    "lint:strict": "node node_modules/eslint/bin/eslint.js . --ext .vue,.ts,.tsx --max-warnings=0 && bun run check:comment-language",
    "check:comment-language": "node scripts/check-comment-language.mjs",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check src/",
    "lint-staged": "node node_modules/lint-staged/bin/lint-staged.js",
    "serve:dist": "node node_modules/vite/bin/vite.js preview --port 3000",
    "clean": "node scripts/clean.mjs",
    "clean:dry-run": "node scripts/clean.mjs --dry-run",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "sitemap:preview": "node scripts/generate-sitemap.js --dry-run",
    "icons:generate": "node scripts/generate-icons.js",
    "screenshots:generate": "bun run scripts/generate-screenshots.ts",
    "fallbacks:refresh": "node scripts/refresh-public-snapshots.mjs",
    "audit": "bun run audit:docs && bun run audit:repo && bun run audit:deps",
    "audit:docs": "node scripts/check-doc-sanitization.mjs",
    "audit:repo": "bun run scripts/audit/index.ts",
    "audit:deps": "bun audit",
    "audit:fix": "bun run scripts/audit/index.ts --fix",
    "commit:cn": "node scripts/git-commit.mjs"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.3.0",
    "@lucide/vue": "1.72.0",
    "@vueuse/core": "15.0.0",
    "dompurify": "3.4.17",
    "gsap": "^3.15.1",
    "lenis": "1.3.27",
    "motion-v": "2.12.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18",
    "vue-router": "5.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-istanbul": "5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/compiler-sfc": "3.5.45",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "knip": "6.45.1",
    "lighthouse": "^13.6.0",
    "lint-staged": "^17.6.0",
    "prettier": "3.10.0",
    "puppeteer": "25.17.0",
    "sharp": "^0.35.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-imagetools": "12.0.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "4.160.1"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "minimatch@^10": "11.0.5",
    "minimatch@~10": "11.0.5",
    "glob@^13": "14.0.4"
  }
}
