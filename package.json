    "dayjs": "^1.11.19",
    "gsap": "^3.13.0",
    "ky": "^1.14.0",
    "lucide-vue-next": "^0.553.0",
    "masonry-layout": "^4.2.2",
    "photoswipe": "^5.4.4",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.24",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.4",
    "@types/jsdom": "^27.0.0",
