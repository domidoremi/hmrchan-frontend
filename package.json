{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ],
  "scripts": {
    "dev": "vite",
    "build": "bun run type-check && vite build",
    "build:analyze": "vite build && node scripts/analyze-bundle.js",
    "build:measure": "node scripts/measure-build-time.js",
    "preview": "vite preview",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:watch": "vitest",
    "type-check": "vue-tsc --noEmit --pretty",
    "type-check:watch": "vue-tsc --noEmit --watch --pretty",
    "prepare": "husky",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "perf:dev": "node scripts/measure-dev-startup.js",
    "perf:hmr": "node scripts/analyze-hmr-performance.js",
    "perf:lighthouse": "node scripts/lighthouse-audit.mjs",
    "perf:build": "node scripts/measure-build-time.js",
    "perf:compare": "node scripts/compare-build-configs.js",
    "lint:strict": "eslint . --ext .vue,.ts,.tsx --max-warnings=0",
    "format:check": "prettier --check src/",
    "lint-staged": "lint-staged",
    "serve:dist": "bunx serve dist -l 3000",
    "clean": "rm -rf dist node_modules/.vite .tsbuildinfo"
  },
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "dayjs": "^1.11.19",
    "gsap": "^3.14.2",
    "ky": "^1.14.1",
    "lucide-vue-next": "^0.553.0",
    "openskills": "^1.3.0",
    "photoswipe": "^5.4.4",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.25",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251217.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.2",
    "@vitest/eslint-plugin": "^1.5.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "chrome-launcher": "^1.2.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "~10.5.1",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^27.3.0",
    "knip": "^5.75.1",
    "lighthouse": "^13.0.1",
    "lint-staged": "^16.2.7",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@^7.3.0",
    "vite-imagetools": "^9.0.2",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.16",
    "vue-tsc": "^3.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.0.0-beta.9-commit.d91dfb5"
  }
}
