{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "sideEffects": [
    "./src/main.ts",
    "*.css",
    "*.vue"
  ],
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:security-check": "node scripts/check-build-security.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "postinstall": "node scripts/patch-lucide.mjs",
    "test:unit": "node scripts/patch-lucide.mjs && node scripts/run-vitest.mjs run --passWithNoTests",
    "test:unit:watch": "node scripts/patch-lucide.mjs && node scripts/run-vitest.mjs",
    "test:coverage": "node scripts/patch-lucide.mjs && node scripts/run-vitest.mjs run --coverage --maxWorkers=1",
    "test:e2e": "bun --smol run scripts/test-e2e.ts",
    "test:functional-chain:local": "bun --smol run scripts/test-functional-chain-local.ts",
    "validate:release": "node scripts/validate-release.mjs",
    "validate:release:hook": "node scripts/validate-release.mjs --mode hook --quiet",
    "validate:release:prepush": "node scripts/validate-release.mjs --mode prepush --quiet",
    "validate:release:prepush:full": "node scripts/validate-release.mjs --mode prepush-full --quiet",
    "validate:release:local": "node scripts/validate-release.mjs --mode local",
    "validate:release:local:quiet": "node scripts/validate-release.mjs --mode local --quiet",
    "validate:release:candidate": "node scripts/validate-release.mjs --mode candidate",
    "validate:release:production": "node scripts/validate-release.mjs --mode production",
    "check:release-evidence": "node scripts/release-evidence.mjs",
    "test:perf": "bun --smol run scripts/test-performance.ts",
    "test:a11y": "bun --smol run scripts/test-accessibility.ts",
    "check:frontend": "bun --smol run scripts/frontend-health-check.ts",
    "type-check": "node scripts/type-check.mjs",
    "type-check:full": "node scripts/type-check.mjs --full",
    "type-check:watch": "node node_modules/vue-tsc/bin/vue-tsc.js -p tsconfig.app.json --noEmit --watch --pretty",
    "prepare": "node node_modules/husky/bin.js",
    "lint": "node node_modules/eslint/bin/eslint.js . --fix --cache --ext .vue,.ts,.tsx,.js,.mjs,.cjs,.mts,.cts",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src/ README.md docs/README.en.md docs/README.ja.md docs/VALIDATION.md docs/VALIDATION.en.md docs/VALIDATION.ja.md public/icons/README.md package.json .prettierrc.json public/_routes.json tsconfig.json tsconfig.app.json tsconfig.node.json tsconfig.vitest.json knip.json lighthouserc.json eslint.config.ts vite.config.ts vitest.config.ts vitest.setup.ts \"scripts/**/*.{js,mjs,ts,json}\"",
    "perf:lighthouse": "node scripts/lighthouse-audit.mjs",
    "perf:lighthouse:prod": "node scripts/lighthouse-prod-audit.mjs",
    "perf:lighthouse:prod:all": "node scripts/lighthouse-prod-audit.mjs --orchestrate",
    "perf:lighthouse:prod:full": "node scripts/lighthouse-prod-full-audit.mjs",
    "test:prod:regression": "node scripts/prod-regression-runner.mjs",
    "lint:strict": "node node_modules/eslint/bin/eslint.js . --ext .vue,.ts,.tsx,.js,.mjs,.cjs,.mts,.cts --max-warnings=0",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check src/ README.md docs/README.en.md docs/README.ja.md docs/VALIDATION.md docs/VALIDATION.en.md docs/VALIDATION.ja.md public/icons/README.md package.json .prettierrc.json public/_routes.json tsconfig.json tsconfig.app.json tsconfig.node.json tsconfig.vitest.json knip.json lighthouserc.json eslint.config.ts vite.config.ts vitest.config.ts vitest.setup.ts \"scripts/**/*.{js,mjs,ts,json}\"",
    "serve:dist": "bunx serve dist -l 3000",
    "clean": "node scripts/clean.mjs",
    "clean:dry-run": "node scripts/clean.mjs --dry-run",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "sitemap:preview": "node scripts/generate-sitemap.js --dry-run",
    "icons:generate": "node scripts/generate-icons.js",
    "screenshots:generate": "bun --smol run scripts/generate-screenshots.ts",
    "fallbacks:refresh": "node scripts/refresh-public-snapshots.mjs",
    "audit": "bun run audit:repo && bun run audit:deps",
    "audit:repo": "bun run scripts/audit/index.ts",
    "audit:list": "bun run scripts/audit/index.ts --list",
    "audit:light": "bun run scripts/audit/index.ts --only=security,env-config,pwa,i18n,frontend-contract",
    "audit:deps": "bun audit",
    "audit:fix": "bun run scripts/audit/index.ts --fix",
    "commit:cn": "node scripts/git-commit.mjs"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@lucide/vue": "^1.27.0",
    "pinia": "^4.0.2",
    "vue": "3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "@vue/compiler-sfc": "3.5.40",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/server-renderer": "3.5.40",
    "@vue/test-utils": "^2.4.11",
    "baseline-browser-mapping": "^2.11.7",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "javascript-obfuscator": "^5.5.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.29.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "puppeteer": "^25.4.0",
    "sharp": "^0.35.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vite-imagetools": "^10.0.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@sentry/node": "10.69.0",
    "baseline-browser-mapping": "^2.11.7",
    "defu": "^6.1.7",
    "brace-expansion": "^5.0.8",
    "yaml": "^2.9.0",
    "picomatch": "^4.0.5",
    "basic-ftp": "^6.0.2",
    "flatted": "^3.4.3",
    "lodash-es": "^4.18.1",
    "minimatch": "^10.2.6",
    "js-cookie": "^3.0.8",
    "ws": "^8.21.1",
    "ip-address": "^10.3.1",
    "postcss": "^8.5.25",
    "tmp": "^0.2.7",
    "vite": "8.1.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.1"
  },
  "description": "> 仅供学习与交流使用。",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domidoremi/hmrchan-frontend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/domidoremi/hmrchan-frontend/issues"
  },
  "homepage": "https://github.com/domidoremi/hmrchan-frontend#readme"
}
