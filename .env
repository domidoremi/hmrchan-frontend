# API Configuration（根据文档）- 后端已迁移到v1
VITE_API_BASE_URL=https://api.momichan.xyz
VITE_API_ENDPOINT=https://api.momichan.xyz/api/v1

# 本地开发 - 使用相对路径，通过Vite proxy代理
VITE_API_URL=/api

# 如果需要直接访问后端（绕过代理），使用完整URL
# VITE_API_URL=http://localhost:8000/api

# WebSocket URL（如果需要）
VITE_WS_URL=wss://api.momichan.xyz/ws

# App Information
VITE_APP_NAME=himeri chan
VITE_APP_DESCRIPTION=Social Media Content Aggregation System

# Environment
NODE_ENV=development
