{
  "extends": "./tsconfig.app.json",
  "include": [
    "src/**/__tests__/*",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "functions/**/__tests__/*",
    "build/vite/plugins/**/__tests__/*",
    "build/vite/plugins/**/*.spec.ts",
    "build/vite/plugins/**/*.ts",
    "env.d.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "types": ["node", "jsdom", "vitest/globals"]
  }
}
