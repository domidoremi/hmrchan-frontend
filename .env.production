# 生产环境配置
# Production Environment Configuration
# AWS EC2 Instance: 54.168.189.160 (ap-northeast-1 Tokyo)

# ⚠️ 重要：生产环境应该使用HTTPS和域名
# 当前使用HTTP + IP地址仅用于测试

# API 基础 URL - AWS EC2实例
VITE_API_URL=http://54.168.189.160:8000/api

# 如果配置了域名和SSL证书，使用以下配置：
# VITE_API_URL=https://api.momichan.xyz/api

# WebSocket URL (如果需要)
VITE_WS_URL=ws://54.168.189.160:8000/ws
# VITE_WS_URL=wss://api.momichan.xyz/ws

# 应用信息
VITE_APP_NAME=himeri chan
VITE_APP_DESCRIPTION=Social Media Content Aggregation System

# 生产环境选项
VITE_ENABLE_DEVTOOLS=false
VITE_LOG_LEVEL=error

# 环境标识
NODE_ENV=production
