# ===========================================
# 前端构建时环境变量 (Vite)
# ===========================================
# 生产/预览环境变量在 wrangler.toml 中配置
# 仅机密变量（Secrets）通过 Cloudflare Dashboard 管理
# 本地开发请复制此文件为 .env.development 并修改
#
# API 路径说明：
# 前端始终通过同源 /api 代理访问后端（默认值已在 client.ts 中硬编码）
# 后端真实地址配置在 wrangler.toml 的 API_BASE_URL 中
# 通常无需设置 VITE_API_ENDPOINT 和 VITE_API_URL

# 应用信息
VITE_APP_NAME=himeri chan
VITE_APP_DESCRIPTION=Social Media Content Aggregation System

# 功能开关（本地开发）
VITE_ENABLE_DEBUG=false
VITE_ENABLE_DEVTOOLS=false
VITE_LOG_LEVEL=warn

# Anti-tamper（运行时软防护）
# 可选值：off | warn | balanced | strict
VITE_ANTI_TAMPER_MODE=balanced
# 仅 strict 模式生效：是否禁用右键
VITE_DISABLE_CONTEXT_MENU=false

# Obfuscation（构建期混淆，默认关闭）
VITE_ENABLE_OBFUSCATION=false
# 可选值：safe | aggressive
VITE_OBFUSCATION_PROFILE=safe
VITE_OBFUSCATION_CONTROL_FLOW=false
VITE_OBFUSCATION_DEAD_CODE=false

# Cloudflare Turnstile (人机验证)
VITE_TURNSTILE_SITE_KEY=
