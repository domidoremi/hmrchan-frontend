# API Configuration - 根据 API-FRONTEND-GUIDE.md
# 基础URL: https://api.momichan.xyz
# API版本: v1

# API端点 (包含 /api/v1)
VITE_API_ENDPOINT=https://api.momichan.xyz/api/v1

# API基础URL (不含 /api)
VITE_API_BASE_URL=https://api.momichan.xyz

# WebSocket URL (如果需要)
VITE_WS_URL=wss://api.momichan.xyz/ws

# 本地开发配置示例:
# VITE_API_ENDPOINT=http://localhost:8000/api/v1
# VITE_API_BASE_URL=http://localhost:8000
