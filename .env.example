# ===========================================
# 前端构建时环境变量 (Vite)
# ===========================================
# 生产/预览环境变量在 wrangler.toml 中配置
# 仅机密变量（Secrets）通过 Cloudflare Dashboard 管理
# 本地开发请复制此文件为 .env.development 并修改
#
# API 路径说明：
# 前端始终通过同源 /api 代理访问后端（默认值已在 client.ts 中硬编码）
# 后端真实地址配置在 wrangler.toml 的 API_BASE_URL 中
# 通常无需设置 VITE_API_ENDPOINT 和 VITE_API_URL
# 本地开发默认只连接本机后端。连接生产 API 必须同时显式设置 ALLOW_PRODUCTION_API_PROXY=true。
VITE_API_BASE_URL=http://127.0.0.1:8000
ALLOW_PRODUCTION_API_PROXY=false
# 远程 HTTPS 上游的 Secure Cookie 默认不降级；仅受控演练可显式开启。
ALLOW_REMOTE_COOKIE_DOWNGRADE=false

# 共享 release contract hash（生产构建必须显式注入；本地开发可留空，dev mode 会回退到 dev-local）
VITE_CLIENT_CONTRACT_VERSION=

# 本地私有 smoke / release-evidence 凭据请写入未跟踪的 .env.smoke.local，不要放进 .env.development

# Cloudflare 运行时 secret（不要加 VITE_ 前缀，也不要提交真实值）：
# Pages production/preview 与 internal API gateway Worker 必须配置同一随机值。
INTERNAL_API_GATEWAY_SHARED_SECRET=

# 功能开关（本地开发）
VITE_ENABLE_DEBUG=false
VITE_ENABLE_DEVTOOLS=false
VITE_LOG_LEVEL=warn
# 是否在应用启动时执行 /api/v1/client/init（默认开启）
VITE_ENABLE_CLIENT_INIT=true
# 是否启用日程接口请求（默认开启）
VITE_ENABLE_SCHEDULE_API=true
# 是否启用后台数据预取（默认开启）
VITE_ENABLE_DATA_PREFETCH=true
# 是否显式启用 Cloudflare Browser Insights beacon（默认关闭，只有 token 与站点配置都正确时才建议开启）
VITE_ENABLE_CF_BEACON=false
# Cloudflare Browser Insights token（只有 VITE_ENABLE_CF_BEACON=true 时才会注入 beacon）
VITE_CF_BEACON_TOKEN=
# 是否延迟加载 animations.css（默认开启）
VITE_ENABLE_DEFERRED_ANIMATION_STYLES=true
# 是否启用 FingerprintJS 高熵指纹（默认关闭，开启会增加首屏主线程负载）
VITE_ENABLE_ADVANCED_FINGERPRINT=false
# 构建时 sourcemap（默认关闭；需要私有排障时可改为 hidden 或 true）
VITE_SOURCEMAP=false

# 认证说明
# Google 快捷登录 / 注册通过后端 /api/v1/auth/google/start 发起，
# /auth/callback 由前端固定路由处理，无需额外配置外部身份提供方地址。
# 若生产需要展示 Google 登录 / 注册按钮，必须显式开启：
VITE_GOOGLE_AUTH_ENABLED=true
# 应用名称与页面描述由 index.html、pageMeta 和 edge metadata 固定管理，不再通过环境变量配置。

# Anti-tamper（运行时软防护）
# 可选值：off | warn | balanced | strict
VITE_ANTI_TAMPER_MODE=balanced
# 开发环境是否也启用 anti-tamper（默认 false）
VITE_ANTI_TAMPER_ALLOW_DEV=false
# 仅 strict 模式生效：是否禁用右键
VITE_DISABLE_CONTEXT_MENU=false

# Obfuscation（构建期混淆，默认关闭；仅显式设置 true 时启用）
VITE_ENABLE_OBFUSCATION=false
# 可选值：safe | aggressive
VITE_OBFUSCATION_PROFILE=safe
# 字符串阵列化（String Array）
VITE_OBFUSCATION_STRING_ARRAY=true
# none | base64 | rc4
VITE_OBFUSCATION_STRING_ARRAY_ENCODING=base64
# anti-formatting（Self Defending）
VITE_OBFUSCATION_ANTI_FORMATTING=false
# infinite debugger（Debug Protection）
VITE_OBFUSCATION_INFINITE_DEBUGGER=false
VITE_OBFUSCATION_INFINITE_DEBUGGER_INTERVAL=0
# 前端代码伪加密（基于 RC4 字符串包裹，不能替代后端校验）
VITE_OBFUSCATION_CODE_ENCRYPTION=false
# 控制流平坦化（Control Flow Flattening）
VITE_OBFUSCATION_CONTROL_FLOW=false
# 废代码注入（Dead Code Injection）
VITE_OBFUSCATION_DEAD_CODE=false

# Cloudflare Turnstile (人机验证)
VITE_TURNSTILE_SITE_KEY=
