# ===========================================
# 前端构建时环境变量 (Vite)
# ===========================================
# 生产/预览环境变量在 wrangler.toml 中配置
# 仅机密变量（Secrets）通过 Cloudflare Dashboard 管理
# 本地开发请复制此文件为 .env.development 并修改

# ===========================================
# 本地开发配置（使用 Vite 代理）
# ===========================================
# 本地开发时使用相对路径，通过 Vite 代理访问后端 API
# 这样可以避免 CORS 问题
# VITE_API_BASE_URL=
# VITE_API_ENDPOINT=/api/v1
# VITE_API_URL=/api

# ===========================================
# 生产环境配置（直接访问 API）
# ===========================================
# 生产环境推荐使用同源 /api 代理，避免 CORS
# 如需直连后端域名，请确保后端已正确配置 CORS
VITE_API_BASE_URL=https://api.momichan.xyz
VITE_API_ENDPOINT=/api/v1
VITE_API_URL=/api

# 应用信息
VITE_APP_NAME=himeri chan
VITE_APP_DESCRIPTION=Social Media Content Aggregation System

# 功能开关（本地开发）
VITE_ENABLE_DEBUG=false
VITE_ENABLE_DEVTOOLS=false
VITE_LOG_LEVEL=warn

# Cloudflare Turnstile (人机验证)
VITE_TURNSTILE_SITE_KEY=
