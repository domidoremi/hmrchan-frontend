# 环境变量示例文件
# Environment Variables Example
# 复制此文件为 .env.development 或 .env.production 并填写实际值

# ========================================
# API 配置
# ========================================

# 开发环境 - 使用Vite代理
# VITE_API_URL=/api

# 开发环境 - 直连本地后端
# VITE_API_URL=http://localhost:8000/api

# 生产环境 - AWS EC2实例
# VITE_API_URL=http://54.168.189.160:8000/api

# 生产环境 - 使用域名和HTTPS (推荐)
# VITE_API_URL=https://api.momichan.xyz/api

# ========================================
# WebSocket 配置 (可选)
# ========================================

# WebSocket URL
# VITE_WS_URL=ws://localhost:8000/ws
# VITE_WS_URL=wss://api.momichan.xyz/ws

# ========================================
# 应用信息
# ========================================

VITE_APP_NAME=himeri chan
VITE_APP_DESCRIPTION=Social Media Content Aggregation System

# ========================================
# 开发工具
# ========================================

# 启用 Vue DevTools (开发环境: true, 生产环境: false)
VITE_ENABLE_DEVTOOLS=true

# 日志级别 (debug, info, warn, error)
VITE_LOG_LEVEL=debug

# ========================================
# 环境标识
# ========================================

NODE_ENV=development
