# Cloudflare Pages HTTP headers

# 通用安全头
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Permissions-Policy: camera=(), microphone=(), geolocation=(), fullscreen=(self), payment=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https:; media-src 'self' https:; object-src 'none'

# HTML 页面 - 短缓存，便于快速更新
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# 主入口（index.html）
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# JavaScript 与 CSS 打包产物 - 长缓存（带哈希）
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# 图片资源
/assets/*.(png|jpg|jpeg|gif|svg|webp|avif)
  Cache-Control: public, max-age=31536000, immutable

# 字体文件
/assets/*.(woff|woff2|ttf|otf)
  Cache-Control: public, max-age=31536000, immutable

# Service Worker - 禁止缓存
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

# Favicon
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
