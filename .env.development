# 开发环境配置
# API 路径默认值 (/api/v1, /api) 已在 client.ts 中硬编码，无需重复定义
VITE_API_BASE_URL=/api
# 开发态默认也走 same-origin façade，以便 next/main 前端入口互相独立且认证态接口获得 BFF cookie/access 注入。
VITE_IDENTITY_API_BASE_URL=/api
VITE_COMMUNITY_API_BASE_URL=/api
VITE_CONTENT_API_BASE_URL=/api
VITE_SOURCEMAP=false
# 默认接入真实后端；离线视觉调试时改为 false 或设置 VITE_HMRCHAN_FORCE_FALLBACK=true
VITE_HMRCHAN_ENABLE_API=true
VITE_HMRCHAN_FORCE_FALLBACK=false

# 共享 release contract hash（开发态可留空并回退到 .env.production 中的当前 release contract；联调其他 contract 时再显式覆盖）
VITE_CLIENT_CONTRACT_VERSION=

# 调试选项
VITE_ENABLE_DEBUG=true
# 本地默认关闭 Vue DevTools 插件，避免 dev 依赖链和内存占用失控；需要时再显式改回 true
VITE_ENABLE_DEVTOOLS=false
VITE_LOG_LEVEL=debug
# 本地后端若未开启 client/init，可临时关闭以避免 429/403 噪音
VITE_ENABLE_CLIENT_INIT=false
# 本地后端若未提供日程接口，可关闭以避免 /schedule 500 噪音
VITE_ENABLE_SCHEDULE_API=false
# 本地后端未就绪时，关闭后台数据预取避免 authors/posts 噪音请求
VITE_ENABLE_DATA_PREFETCH=false
# 开发环境保持延迟加载动画样式，与生产一致
VITE_ENABLE_DEFERRED_ANIMATION_STYLES=true
# 开发环境默认关闭 FingerprintJS 高熵指纹，减少首屏开销
VITE_ENABLE_ADVANCED_FINGERPRINT=false

# Anti-tamper（开发环境建议保守）
VITE_ANTI_TAMPER_MODE=warn
# 注意：默认 DEV 下不会生效。仅调试 anti-tamper 时改为 true
VITE_ANTI_TAMPER_ALLOW_DEV=false
VITE_DISABLE_CONTEXT_MENU=false

# Obfuscation（开发环境默认关闭）
VITE_ENABLE_OBFUSCATION=false
VITE_OBFUSCATION_PROFILE=safe
VITE_OBFUSCATION_STRING_ARRAY=true
VITE_OBFUSCATION_STRING_ARRAY_ENCODING=base64
VITE_OBFUSCATION_ANTI_FORMATTING=false
VITE_OBFUSCATION_INFINITE_DEBUGGER=false
VITE_OBFUSCATION_INFINITE_DEBUGGER_INTERVAL=0
VITE_OBFUSCATION_CODE_ENCRYPTION=false
VITE_OBFUSCATION_CONTROL_FLOW=false
VITE_OBFUSCATION_DEAD_CODE=false

# Cloudflare Turnstile (人机验证)
# 开发环境可以使用测试密钥或真实密钥
# 生产环境密钥必须在 Cloudflare Pages Dashboard 中配置
# 测试密钥参考: https://developers.cloudflare.com/turnstile/troubleshooting/testing/

# 测试密钥（总是通过，用于开发测试）
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# 真实密钥（从 Cloudflare Dashboard > Turnstile 获取）
VITE_TURNSTILE_SITE_KEY=
