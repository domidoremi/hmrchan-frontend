# 开发环境配置

# API 配置 - 本地开发使用代理，避免 CORS 问题
# 使用相对路径 /api，Vite 会自动代理到 https://api.momichan.xyz
VITE_API_BASE_URL=
VITE_API_ENDPOINT=/api/v1
VITE_API_URL=/api

# 应用信息
VITE_APP_NAME=himeri chan
VITE_APP_DESCRIPTION=Social Media Content Aggregation System

# 调试选项
VITE_ENABLE_DEVTOOLS=true
VITE_LOG_LEVEL=debug

# Cloudflare Turnstile (人机验证)
# 开发环境可以使用测试密钥或真实密钥
# 生产环境密钥必须在 Cloudflare Pages Dashboard 中配置
# 测试密钥参考: https://developers.cloudflare.com/turnstile/troubleshooting/testing/

# 测试密钥（总是通过，用于开发测试）
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# 真实密钥（从 Cloudflare Dashboard > Turnstile 获取）
VITE_TURNSTILE_SITE_KEY=
