{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/router/index.ts", "src/sw/index.ts", "src/**/*.vue", "functions/**/*.ts"],
  "project": ["src/**/*.{ts,vue}", "functions/**/*.ts", "*.config.ts", "vite-plugin-*.ts"],
  "ignore": [
    "src/**/*.d.ts",
    "src/**/index.ts",
    "**/__tests__/**",
    "**/*.spec.ts",
    "src/utils/notifications/pushManager.ts"
  ],
  "ignoreDependencies": [
    "@cloudflare/*",
    "chrome-launcher",
    "lighthouse",
    "@types/*",
    "@vue/test-utils"
  ],
  "ignoreUnresolved": ["vitest.setup.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [],
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "warn",
    "unlisted": "error",
    "unresolved": "warn",
    "nsExports": "warn",
    "nsTypes": "warn"
  }
}
