{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/main.ts", "src/router/index.ts", "vite.config.ts", "src/**/*.vue"],
  "project": ["src/**/*.{ts,vue}"],
  "ignore": ["src/**/*.d.ts", "env.d.ts", "functions/**/*", "src/**/index.ts"],
  "ignoreDependencies": ["@cloudflare/*"],
  "ignoreExportsUsedInFile": true
}
