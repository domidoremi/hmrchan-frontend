{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.ts",
    "src/router/index.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.ts",
    "src/**/*.vue"
  ],
  "project": ["src/**/*.{ts,vue}", "*.config.ts", "vite-plugin-*.ts"],
  "ignore": [
    "src/**/*.d.ts",
    "env.d.ts",
    "functions/**/*",
    "src/**/index.ts",
    "**/__tests__/**",
    "**/*.spec.ts",
    "**/*.test.ts",
    "scripts/**/*",
    "dist/**/*",
    "node_modules/**/*",
    ".husky/**/*",
    "public/**/*"
  ],
  "ignoreDependencies": [
    "@cloudflare/*",
    "@rolldown/*",
    "chrome-launcher",
    "lighthouse",
    "jiti",
    "@types/*",
    "@tsconfig/*",
    "husky",
    "lint-staged",
    "prettier"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["bunx", "uvx", "bun", "node"],
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "warn",
    "unlisted": "error",
    "unresolved": "warn",
    "nsExports": "warn",
    "nsTypes": "warn"
  },
  "workspaces": {
    ".": {
      "entry": [
        "src/main.ts",
        "src/router/index.ts"
      ],
      "project": [
        "src/**/*.{ts,vue}"
      ]
    }
  }
}
