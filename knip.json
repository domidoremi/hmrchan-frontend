{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/router/index.ts", "vitest.setup.ts", "src/**/*.vue"],
  "project": ["src/**/*.{ts,vue}", "*.config.ts", "vite-plugin-*.ts"],
  "ignore": [
    "src/**/*.d.ts",
    "env.d.ts",
    "functions/**/*",
    "src/**/index.ts",
    "**/__tests__/**",
    "**/*.spec.ts",
    "**/*.test.ts",
    "scripts/**/*",
    "dist/**/*",
    "node_modules/**/*",
    ".husky/**/*",
    "public/**/*",
    "src/utils/notifications/pushManager.ts"
  ],
  "ignoreDependencies": [
    "@cloudflare/*",
    "chrome-launcher",
    "lighthouse",
    "@types/*",
    "@vue/test-utils"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [],
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "warn",
    "unlisted": "error",
    "unresolved": "warn",
    "nsExports": "warn",
    "nsTypes": "warn"
  }
}
