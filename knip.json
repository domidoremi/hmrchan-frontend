{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/router/index.ts", "src/**/*.vue", "functions/**/*.ts"],
  "project": ["src/**/*.{ts,vue}", "functions/**/*.ts", "*.config.ts"],
  "ignore": ["src/**/index.ts", "src/fallbacks/generated/publicSnapshots.ts"],
  "ignoreDependencies": ["@cloudflare/*", "baseline-browser-mapping", "javascript-obfuscator"],
  "ignoreUnresolved": [],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/api/hmrContentFallbacks.ts": ["duplicates"]
  },
  "ignoreBinaries": [],
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "warn",
    "unlisted": "error",
    "unresolved": "warn",
    "nsExports": "warn",
    "nsTypes": "warn"
  }
}
