{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts",
    "src/sw/index.ts",
    "scripts/local-pages-preview.ts",
    "functions/**/*.ts",
    "workers/internal-api/index.ts"
  ],
  "project": [
    "src/**/*.{ts,vue}",
    "functions/**/*.ts",
    "workers/**/*.ts",
    "build/**/*.ts",
    "scripts/**/*.{js,mjs,ts}",
    "*.config.ts",
    "vite-plugin-*.ts"
  ],
  "ignore": ["src/**/*.d.ts"],
  "ignoreDependencies": [
    "@cloudflare/*",
    "chrome-launcher",
    "lighthouse",
    "@types/*",
    "@vue/test-utils"
  ],
  "ignoreUnresolved": ["vitest.setup.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["rg"],
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "warn",
    "unlisted": "error",
    "unresolved": "warn",
    "nsExports": "warn",
    "nsTypes": "warn"
  }
}
